---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import EnServiceCards from '../../../components/EnServiceCards.astro';
import CtaBand from '../../../components/CtaBand.astro';
import hero from '../../../assets/fotos/izaje-chiller-grua.webp';
---
<Base
  lang="en"
  title="Industrial machinery installation, rigging & relocation services | AGELVIS EU"
  description="Machinery installation, dismantling, rigging, export packing, plant relocation and site preparation. A Colombian industrial contractor for projects in Latin America and worldwide."
  image={hero}
  alternate={{ lang: 'es', href: '/servicios' }}
>
  <PageHero
    lang="en"
    title="Industrial machinery services"
    eyebrow="Services"
    lead="Hire a single task or a turnkey scope. Every project is defined after a technical assessment."
    image={hero}
    imageAlt="Industrial chiller lifted by crane by AGELVIS EU"
    breadcrumbs={[{ label: 'Services' }]}
  />
  <section class="section">
    <div class="container"><EnServiceCards /></div>
  </section>
  <CtaBand lang="en" />
</Base>
