---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import { site, whatsappUrl } from '../../data/site';
import type { IconName } from '../../data/icons';
import hero from '../../assets/fotos/movimiento-maquina-envuelta-planta.webp';
import rigging from '../../assets/fotos/izaje-maquinaria-envuelta.webp';
import packing from '../../assets/fotos/embalaje-guacal-equipo-planta.webp';

const scope: { icon: IconName; t: string; d: string }[] = [
  { icon: 'package', t: 'Receiving & unpacking', d: 'Container unloading, crate opening, inspection and condition reports.' },
  { icon: 'crane', t: 'Rigging & in-plant moving', d: 'Planned lifts and moves from receiving area to final position, using skates, forklifts and cranes.' },
  { icon: 'gear', t: 'Positioning & mechanical assembly', d: 'Placement, leveling, alignment, assembly and anchoring per manufacturer specifications.' },
  { icon: 'users', t: 'Support for your field engineers', d: 'Local crew on site during commissioning and adjustments.' },
  { icon: 'zap', t: 'Utility hook-ups via partners', d: 'Electrical, compressed air, water and gas through licensed local partners, as scoped.' },
  { icon: 'truck', t: 'Relocation & export packing', d: 'Dismantling, technical packaging and relocation of installed lines between plants or countries.' },
];
const msg = 'Hello AGELVIS EU, we are a machinery manufacturer and would like to discuss local installation support in Colombia.';
---
<Base
  lang="en"
  title="Machinery installation & rigging contractor in Colombia for OEMs | AGELVIS EU"
  description="Local installation partner for machinery manufacturers (OEMs) in Colombia and Latin America: receiving, unpacking, rigging, positioning and mechanical assembly."
  image={hero}
  alternate={{ lang: 'es', href: '/fabricantes-oem' }}
>
  <PageHero
    lang="en"
    title="Your local installation partner in Colombia"
    eyebrow="For machinery manufacturers · OEM"
    lead="AGELVIS EU handles the on-site execution of machinery installations in Colombia and Latin America, and supports relocations to and from other countries, so your service engineers can focus on commissioning."
    image={hero}
    imageAlt="New packed machine being moved to its installation point in a plant"
    breadcrumbs={[{ label: 'For OEMs' }]}
  >
    <div class="btn-row hero-ctas">
      <a href="#contact" class="btn btn--primary" data-track="cta_click" data-track-location="en-hero">Discuss a project <Icon name="arrow" /></a>
      <a href="/en/international" class="btn btn--ghost"><Icon name="globe" /> International projects</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container two">
      <div>
        <p class="eyebrow">Who we are</p>
        <h2>Industrial engineering and machinery installation since {site.foundingYear}</h2>
        <p>Based in Palmira (Valle del Cauca, Colombia), AGELVIS EU plans and executes installation, dismantling, rigging, technical packaging and relocation of industrial machinery and production lines.</p>
        <p><strong>We handle the complete operation:</strong> we plan the job, engineer each lift and move, and coordinate crews, tools and lifting equipment, our own or from specialized partners, according to each project.</p>
        <p>Our team has worked in plants for food & beverage, pharma, paper & tissue, packaging, printing, plastics, glass and metalworking, with project experience outside Colombia.</p>
      </div>
      <Image src={rigging} alt="Crane lift of a wrapped industrial machine into a plant, executed by AGELVIS EU" widths={[480, 720]} sizes="(max-width: 860px) 100vw, 480px" class="img" />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head"><p class="eyebrow">Scope</p><h2>What we can execute for you</h2></div>
      <ol class="model">
        {scope.map((m, i) => (<li class="card" data-reveal style={`--i:${i % 3}`}><div class="top"><span class="icon-tile icon-tile--solid"><Icon name={m.icon} /></span><span class="n">{String(i + 1).padStart(2, '0')}</span></div><h3>{m.t}</h3><p>{m.d}</p></li>))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container two">
      <Image src={packing} alt="AGELVIS EU crew closing a custom wooden export crate around a machine" widths={[480, 720]} sizes="(max-width: 860px) 100vw, 480px" class="img" />
      <div>
        <p class="eyebrow">How we work with OEMs</p>
        <h2>Subcontracting model</h2>
        <ul class="check-list">
          <li>You define the local scope; we submit a technical proposal with resources, schedule and responsibilities.</li>
          <li>We work from your manuals, drawings and installation instructions, under your technical supervision.</li>
          <li>Company and crew documentation for plant access in Colombia (social security, insurance, safety requirements).</li>
          <li>Single local point of contact for mechanical execution.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--dark" id="contact">
    <div class="container contact">
      <div>
        <p class="eyebrow">Contact</p>
        <h2>Selling machinery to Colombia or Latin America?</h2>
        <p class="lead">Tell us about your next installation. We reply with a first technical assessment and next steps.</p>
      </div>
      <ul>
        <li><a href={whatsappUrl(msg)} target="_blank" rel="noopener" data-track="whatsapp_click" data-track-location="en-contact"><Icon name="whatsapp" /> WhatsApp {site.whatsapp.label}</a></li>
        <li><a href={`mailto:${site.email}?subject=OEM%20installation%20partnership`} data-track="email_click" data-track-location="en-contact"><Icon name="mail" /> {site.email}</a></li>
        {site.phones.map((p) => <li><a href={p.href} data-track="phone_click"><Icon name="phone" /> {p.label}</a></li>)}
        <li><span><Icon name="pin" /> Palmira, Valle del Cauca, Colombia</span></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero-ctas { margin-top: 28px; }
  .two { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  .model { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .model li { padding: 28px; }
  .top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
  .n { font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; color: var(--line); }
  .model h3 { margin: 0 0 8px; }
  .model p { color: var(--ink-soft); margin: 0; }
  .contact { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: center; }
  .contact ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .contact ul a, .contact ul span { display: inline-flex; align-items: center; gap: 12px; color: #fff; text-decoration: none; font-weight: 600; font-size: 1.1rem; overflow-wrap: anywhere; }
  .contact ul a:hover { color: var(--brand-orange); }
  .contact :global(svg) { width: 40px; height: 40px; padding: 9px; border-radius: 4px; background: rgb(255 255 255 / 0.08); color: var(--brand-orange); flex: none; }
  @media (max-width: 900px) { .two, .contact { grid-template-columns: 1fr; } .model { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .model { grid-template-columns: 1fr; } }
</style>
