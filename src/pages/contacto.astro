---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappUrl } from '../data/site';
---
<Base
  title="Solicitar evaluación técnica | Contacto AGELVIS EU"
  description="Solicite una evaluación técnica para montaje, traslado, embalaje o relocalización de maquinaria industrial. WhatsApp, teléfono y formulario. Palmira, Valle del Cauca."
>
  <PageHero
    title="Solicite una evaluación técnica"
    eyebrow="Contacto"
    lead="Cuéntenos en pocas palabras qué necesita. Le respondemos con los siguientes pasos."
    breadcrumbs={[{ label: 'Contacto' }]}
  />
  <section class="section">
    <div class="container layout">
      <div class="form-card"><ContactForm /></div>
      <aside>
        <h2>Contacto directo</h2>
        <ul>
          <li>
            <span class="icon-tile icon-tile--solid"><Icon name="whatsapp" /></span>
            <div><strong>WhatsApp</strong><a href={whatsappUrl()} target="_blank" rel="noopener" data-track="whatsapp_click" data-track-location="contacto">{site.whatsapp.label}</a></div>
          </li>
          <li>
            <span class="icon-tile"><Icon name="phone" /></span>
            <div><strong>Teléfonos</strong>{site.phones.map((p) => <a href={p.href} data-track="phone_click" data-track-location="contacto">{p.label}</a>)}</div>
          </li>
          <li>
            <span class="icon-tile"><Icon name="mail" /></span>
            <div><strong>Correo</strong><a href={`mailto:${site.email}`} data-track="email_click" data-track-location="contacto">{site.email}</a></div>
          </li>
          {site.address.publish && (
            <li>
              <span class="icon-tile"><Icon name="pin" /></span>
              <div><strong>Dirección</strong><span>{site.address.street}, {site.address.city}, {site.address.region}, {site.address.country}</span></div>
            </li>
          )}
          <li>
            <span class="icon-tile"><Icon name="clock" /></span>
            <div><strong>Horario</strong><span>{site.hours}</span></div>
          </li>
        </ul>
        {site.address.publish && (
          <iframe
            title="Ubicación de AGELVIS EU en Palmira"
            src={`https://www.google.com/maps?q=${encodeURIComponent(`${site.address.street}, ${site.address.city}, ${site.address.region}, Colombia`)}&output=embed`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        )}
      </aside>
    </div>
  </section>
</Base>

<style>
  .layout { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(32px, 5vw, 56px); align-items: start; }
  .form-card { background: #fff; padding: clamp(24px, 4vw, 40px); border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  aside { background: var(--grad-soft); padding: 32px; border: 1px solid var(--line); border-radius: var(--radius-lg); }
  aside h2 { font-size: 1.8rem; }
  aside ul { list-style: none; margin: 0 0 24px; padding: 0; display: grid; gap: 20px; }
  aside li { display: flex; gap: 14px; align-items: flex-start; }
  aside .icon-tile { width: 44px; height: 44px; border-radius: 12px; }
  aside .icon-tile :global(svg) { width: 22px; height: 22px; }
  aside li div { display: grid; gap: 2px; overflow-wrap: anywhere; }
  aside strong { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-soft); }
  aside a { color: var(--ink); text-decoration: none; }
  aside a:hover { color: var(--brand-blue); }
  iframe { width: 100%; height: 240px; border: 0; border-radius: var(--radius); }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }
</style>

