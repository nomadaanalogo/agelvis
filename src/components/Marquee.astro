---
/** Franja en movimiento continuo con capacidades y sectores. */
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';

const items: { icon: IconName; t: string }[] = [
  { icon: 'gear', t: 'Montaje de maquinaria' },
  { icon: 'crane', t: 'Rigging industrial' },
  { icon: 'truck', t: 'Traslado de equipos' },
  { icon: 'package', t: 'Embalaje de exportación' },
  { icon: 'factory', t: 'Relocalización de plantas' },
  { icon: 'ruler', t: 'Layout y adecuaciones' },
  { icon: 'cup', t: 'Alimentos y bebidas' },
  { icon: 'printer', t: 'Artes gráficas' },
  { icon: 'paper', t: 'Papel y tissue' },
  { icon: 'bottle', t: 'Plásticos' },
];
---
<div class="marquee" aria-label="Capacidades y sectores">
  <div class="track">
    {[0, 1].map((copy) => (
      <ul aria-hidden={copy === 1 ? 'true' : undefined}>
        {items.map((it) => <li><Icon name={it.icon} />{it.t}</li>)}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    margin-top: 40px;
    border-block: 1px solid var(--line);
    background: #fff;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track { display: flex; width: max-content; animation: scroll 45s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  ul { display: flex; list-style: none; margin: 0; padding: 0; }
  li {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
    padding: 16px 32px;
    border-right: 1px solid var(--line);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }
  li :global(svg) {
    width: 30px; height: 30px; padding: 6px; flex: none;
    border-radius: 4px; background: var(--grad-orange); color: #1b0f05;
  }
  @keyframes scroll { to { translate: -50% 0; } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; } }
</style>
