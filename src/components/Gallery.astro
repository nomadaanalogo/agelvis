---
/** Registro fotográfico de trabajos reales de AGELVIS EU. */
import { Image } from 'astro:assets';
import pesada from '../assets/fotos/traslado-maquinaria-pesada-camabaja.webp';
import chiller from '../assets/fotos/izaje-chiller-industrial.webp';
import guacal from '../assets/fotos/embalaje-guacal-equipo-planta.webp';
import okuma from '../assets/fotos/montacargas-maquina-cnc-okuma.webp';
import envuelta from '../assets/fotos/izaje-maquinaria-envuelta.webp';
import trailer from '../assets/fotos/carga-asegurada-trailer-plataforma.webp';
import ingreso from '../assets/fotos/ingreso-carga-guiada-almacen.webp';
import camaBajaBodega from '../assets/fotos/carga-envuelta-cama-baja-bodega.webp';
import mantenimiento from '../assets/fotos/mantenimiento-planta-industrial.webp';
import techo from '../assets/fotos/grua-elevando-chiller-techo.webp';
import patio from '../assets/fotos/maquinaria-montacargas-patio-fabrica.webp';
import movimiento from '../assets/fotos/movimiento-maquina-envuelta-planta.webp';
import calle from '../assets/fotos/traslado-carga-asegurada-calle.webp';
import almacen from '../assets/fotos/maquina-industrial-almacen.webp';
import prensa from '../assets/fotos/desmontaje-prensa-offset.webp';
import troqueladora from '../assets/fotos/movimiento-troqueladora-montacargas.webp';
import contenedor from '../assets/fotos/cargue-montacargas-contenedor.webp';
import tableros from '../assets/fotos/instalacion-tableros-control-planta.webp';

interface Props { limit?: number; lang?: 'es' | 'en' }
const { limit, lang = 'es' } = Astro.props;
const tagsEn: Record<string, string> = { Rigging: 'Rigging', Traslado: 'Transport', Desmontaje: 'Dismantling', Embalaje: 'Packing', Montaje: 'Installation', Cargue: 'Loading' };
const fotos = [
  { src: pesada, alt: 'Técnicos asegurando maquinaria pesada sobre cama baja para su traslado', tag: 'Traslado' },
  { src: chiller, alt: 'Izaje de chiller industrial con eslingas y grúa', tag: 'Rigging' },
  { src: guacal, alt: 'Cierre de guacal de madera a la medida alrededor de un equipo', tag: 'Embalaje' },
  { src: okuma, alt: 'Montacargas de alta capacidad levantando un centro de mecanizado CNC', tag: 'Traslado' },
  { src: envuelta, alt: 'Izaje de maquinaria envuelta hacia el interior de una nave industrial', tag: 'Rigging' },
  { src: trailer, alt: 'Carga industrial cubierta y asegurada con cinchas en tráiler de plataforma', tag: 'Traslado' },
  { src: ingreso, alt: 'Técnicos guiando el ingreso de una máquina embalada a la bodega', tag: 'Montaje' },
  { src: camaBajaBodega, alt: 'Equipo envuelto en film sobre cama baja dentro de bodega', tag: 'Embalaje' },
  { src: mantenimiento, alt: 'Técnico interviniendo maquinaria en planta industrial', tag: 'Montaje' },
  { src: techo, alt: 'Grúa elevando un chiller hacia la cubierta de un edificio industrial', tag: 'Rigging' },
  { src: patio, alt: 'Máquina industrial cargada sobre camión con apoyo de montacargas', tag: 'Cargue' },
  { src: movimiento, alt: 'Desplazamiento de máquina embalada dentro de una planta', tag: 'Montaje' },
  { src: calle, alt: 'Carga industrial asegurada sobre vehículo de plataforma', tag: 'Traslado' },
  { src: almacen, alt: 'Máquina industrial posicionada en planta de manufactura', tag: 'Montaje' },
  { src: prensa, alt: 'Desmontaje de prensa offset en planta de artes gráficas', tag: 'Desmontaje' },
  { src: troqueladora, alt: 'Movimiento de troqueladora con montacargas de alta capacidad', tag: 'Traslado' },
  { src: contenedor, alt: 'Cargue de guacal en contenedor con montacargas', tag: 'Cargue' },
  { src: tableros, alt: 'Tableros de control posicionados en planta para su instalación', tag: 'Montaje' },
].slice(0, limit);
---
<ul class="gallery">
  {fotos.map((f, i) => (
    <li data-reveal style={`--i:${i % 3}`}>
      <Image src={f.src} alt={f.alt} widths={[400, 720]} sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 400px" />
      <span>{lang === 'es' ? f.tag : tagsEn[f.tag]}</span>
    </li>
  ))}
</ul>

<style>
  .gallery { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  li { position: relative; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 20px; background: var(--surface-alt); }
  li::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 60%, rgb(12 10 38 / 0.45)); pointer-events: none; }
  img { width: 100%; height: 100%; object-fit: cover; transition: scale 0.8s var(--ease); }
  li:hover img { scale: 1.06; }
  span {
    position: absolute; left: 12px; bottom: 12px;
    z-index: 1;
    background: rgb(255 255 255 / 0.16); backdrop-filter: blur(8px); color: #fff;
    font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; font-size: 0.78rem;
    padding: 5px 12px; border-radius: 999px; border: 1px solid rgb(255 255 255 / 0.25);
  }
  @media (max-width: 900px) { .gallery { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .gallery { grid-template-columns: 1fr; } }
</style>
