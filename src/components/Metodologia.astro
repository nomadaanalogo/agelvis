---
import Icon from './Icon.astro';
import { metodologia } from '../data/contenido';
---
<ol class="steps">
  {metodologia.map((s, i) => (
    <li data-reveal style={`--i:${i % 3}`}>
      <div class="top">
        <span class="icon-tile"><Icon name={s.icono} /></span>
        <span class="num">{String(i + 1).padStart(2, '0')}</span>
      </div>
      <h3>{s.titulo}</h3>
      <p>{s.texto}</p>
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; counter-reset: step; }
  li {
    position: relative;
    padding: 28px;
    border-radius: 20px;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.02));
    border: 1px solid rgb(255 255 255 / 0.1);
    transition: border-color 0.3s, background 0.3s, transform 0.4s var(--ease);
  }
  li:hover { border-color: rgb(251 122 48 / 0.5); transform: translateY(-4px); background: linear-gradient(160deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.03)); }
  .top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1;
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0.9;
  }
  h3 { font-size: 1.12rem; margin-bottom: 8px; }
  p { margin: 0; color: #bdbbd6; font-size: 0.98rem; }
  @media (max-width: 900px) { .steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }
</style>
