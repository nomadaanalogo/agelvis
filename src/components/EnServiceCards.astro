---
/** Tarjetas de servicios en inglés (misma apariencia que ServiceCard). */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { getServicios } from '../lib/colecciones';
import { enServicios } from '../data/en';
import type { IconName } from '../data/icons';

const servicios = await getServicios();
---
<div class="cards">
  {servicios.map((s, i) => {
    const en = enServicios[s.id];
    return (
      <article class="card svc" data-reveal style={`--i:${i % 3}`}>
        <div class="media">
          <Image src={s.data.imagen} alt={en.title} widths={[400, 640]} sizes="(max-width: 700px) 100vw, 400px" />
        </div>
        <div class="body">
          <span class="icon-tile icon-tile--solid"><Icon name={s.data.icono as IconName} /></span>
          <h3><a href={`/en/services/${en.slug}`}>{en.short}</a></h3>
          <p>{en.summary}</p>
          <span class="more" aria-hidden="true">View service <Icon name="arrow" /></span>
        </div>
      </article>
    );
  })}
</div>

<style>
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .svc { display: flex; flex-direction: column; overflow: hidden; }
  .media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface-alt); }
  .media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgb(12 10 38 / 0.35)); }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: scale 0.8s var(--ease); }
  .svc:hover .media img { scale: 1.07; }
  .body { position: relative; padding: 0 26px 26px; display: flex; flex-direction: column; flex: 1; }
  .icon-tile { margin-top: -26px; margin-bottom: 16px; border: 4px solid #fff; width: 60px; height: 60px; border-radius: 18px; }
  h3 { font-size: 1.22rem; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  p { color: var(--ink-soft); font-size: 0.98rem; flex: 1; }
  .more { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 0.95rem; color: var(--brand-blue); }
  .more :global(svg) { width: 18px; height: 18px; transition: translate 0.3s var(--ease); }
  .svc:hover .more :global(svg) { translate: 5px 0; }
  @media (max-width: 1000px) { .cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 680px) { .cards { grid-template-columns: 1fr; } }
</style>
