---
/**
 * Grúa torre ilustrada para el hero del one-page.
 * El cable, el gancho y el guacal (#crane-pend, #crane-load, .crane-cable) los mueve
 * src/scripts/onepage.ts según el scroll; aquí solo se dibuja la estructura.
 * Coordenadas en un lienzo de 800 × 1000.
 */
interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;

// Celosía del mástil (x 640–690, de y 118 hacia abajo)
let mast = 'M640 118V1000M690 118V1000';
for (let y = 118; y < 1000; y += 50) mast += `M640 ${y}H690M640 ${y}L690 ${y + 50}`;

// Celosía de la pluma (de x 60 a 640, entre y 118 y 160)
let jib = 'M60 118H790M60 160H640M60 118V160';
for (let x = 60; x < 640; x += 40) jib += `M${x} 160L${x + 20} 118L${x + 40} 160`;

// Contrapluma
let counter = 'M690 146H790M790 118V146';
for (let x = 690; x < 790; x += 25) counter += `M${x} 146L${x + 12.5} 118L${x + 25} 146`;

const fragile = lang === 'es' ? 'FRÁGIL · ESTE LADO ARRIBA' : 'FRAGILE · THIS SIDE UP';
---
<svg class="crane" viewBox="0 0 800 1000" preserveAspectRatio="xMaxYMax meet" aria-hidden="true">
  <defs>
    <pattern id="crate-planks" width="230" height="34" patternUnits="userSpaceOnUse">
      <rect width="230" height="34" fill="#c98d52" />
      <path d="M0 33.5H230" stroke="#8d5a2b" stroke-width="2" />
      <path d="M12 9C60 7 90 12 140 9S210 11 228 8M4 22C50 24 120 19 170 23S220 21 230 24" stroke="#b07740" stroke-width="1" fill="none" opacity="0.7" />
    </pattern>
    <linearGradient id="crane-steel" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffcf4a" />
      <stop offset="1" stop-color="#f29a1f" />
    </linearGradient>
    <pattern id="hazard" width="28" height="28" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="28" height="28" fill="#141226" />
      <rect width="14" height="28" fill="#f5b82e" />
    </pattern>
  </defs>

  <!-- Estructura -->
  <g class="crane-steel" fill="none" stroke="url(#crane-steel)" stroke-width="3.2" stroke-linejoin="round">
    <path d={mast} />
    <path d={jib} />
    <path d={counter} />
    <path d="M640 118L665 30L690 118" stroke-width="4" />
    <path d="M665 30L120 118M665 30L786 118" stroke-width="1.6" opacity="0.8" />
  </g>
  <g class="crane-parts">
    <rect x="732" y="146" width="56" height="20" fill="#3b3757" />
    <rect x="732" y="168" width="56" height="20" fill="#2e2a48" />
    <rect x="732" y="190" width="56" height="20" fill="#3b3757" />
    <rect x="694" y="162" width="34" height="40" rx="4" fill="#f5b82e" />
    <rect x="699" y="168" width="24" height="16" rx="2" fill="#0c0a26" opacity="0.75" />
    <circle cx="665" cy="30" r="5" fill="#fb7a30" class="crane-beacon" />
  </g>

  <!-- Plataforma de cargue -->
  <rect x="150" y="952" width="500" height="48" fill="url(#hazard)" />
  <rect x="150" y="946" width="500" height="8" fill="#2a2645" />

  <!-- Carro, cable y carga (posiciones iniciales; el script las actualiza) -->
  <g id="crane-trolley" transform="translate(330 160)">
    <rect x="-20" y="0" width="40" height="12" rx="2" fill="#f5b82e" />
    <circle cx="-11" cy="0" r="4" fill="#0c0a26" />
    <circle cx="11" cy="0" r="4" fill="#0c0a26" />
  </g>
  <g id="crane-pend" transform="translate(330 172)">
    <line class="crane-cable" x1="-6" y1="0" x2="-6" y2="508" stroke="#d9d7ea" stroke-width="2" />
    <line class="crane-cable" x1="6" y1="0" x2="6" y2="508" stroke="#d9d7ea" stroke-width="2" />
    <g id="crane-load" transform="translate(0 508)">
      <!-- Polea y gancho -->
      <rect x="-18" y="-4" width="36" height="30" rx="5" fill="#f5b82e" />
      <rect x="-18" y="8" width="36" height="6" fill="#141226" />
      <path d="M0 26V38a10 10 0 1 1-10 10" fill="none" stroke="#d9d7ea" stroke-width="5" stroke-linecap="round" />
      <!-- Eslingas -->
      <path d="M0 52L-104 100M0 52L104 100" stroke="#fb7a30" stroke-width="4" />
      <!-- Guacal -->
      <g transform="translate(-115 100)">
        <rect width="230" height="170" fill="url(#crate-planks)" />
        <path d="M8 8L222 162M222 8L8 162" stroke="#9c6430" stroke-width="12" />
        <rect x="5" y="5" width="220" height="160" fill="none" stroke="#7a4a22" stroke-width="10" />
        <rect x="58" y="58" width="114" height="54" fill="#c98d52" opacity="0.92" />
        <text x="115" y="88" text-anchor="middle" class="crate-brand">AGELVIS</text>
        <text x="115" y="106" text-anchor="middle" class="crate-sub">E.U · GESTIÓN DE PROYECTOS</text>
        <text x="115" y="150" text-anchor="middle" class="crate-sub crate-fragile">{fragile}</text>
        <path d="M24 30l10-14 10 14h-6v12h-8V30zM46 30l10-14 10 14h-6v12h-8V30z" fill="#2b1a0c" opacity="0.72" />
      </g>
    </g>
  </g>
</svg>

<style>
  .crane { display: block; height: 100%; width: auto; overflow: visible; }
  .crane-beacon { animation: beacon 1.6s steps(1) infinite; }
  .crate-brand { font: 700 30px/1 'IBM Plex Sans Condensed', sans-serif; letter-spacing: 3px; fill: #2b1a0c; opacity: 0.85; }
  .crate-sub { font: 700 9.5px/1 'IBM Plex Sans Condensed', sans-serif; letter-spacing: 1.5px; fill: #2b1a0c; opacity: 0.75; }
  .crate-fragile { font-size: 11px; }
  @keyframes beacon { 50% { opacity: 0.15; } }
  @media (prefers-reduced-motion: reduce) { .crane-beacon { animation: none; } }
</style>
