---
import Icon from './Icon.astro';
import { whatsappUrl } from '../data/site';

interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const msg = lang === 'es' ? undefined : 'Hello AGELVIS EU, I would like to discuss an industrial machinery installation project.';
---
<a class="wa-float" href={whatsappUrl(msg)} target="_blank" rel="noopener" data-track="whatsapp_click" data-track-location="flotante">
  <Icon name="whatsapp" />
  <span class="visually-hidden">{lang === 'es' ? 'Escribir por WhatsApp' : 'Message us on WhatsApp'}</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 60;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, #3be47b, #1ebe5a);
    color: #fff;
    isolation: isolate;
    box-shadow: 0 10px 24px -6px rgb(0 0 0 / 0.35);
    transition: transform 0.2s;
  }
  .wa-float::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25d366;
    z-index: -1;
    animation: pulse 2.4s ease-out infinite;
  }
  .wa-float:hover { transform: scale(1.08); color: #fff; }
  @keyframes pulse { 0% { scale: 1; opacity: 0.55; } 100% { scale: 1.7; opacity: 0; } }
  .wa-float :global(svg) { width: 32px; height: 32px; }
</style>
