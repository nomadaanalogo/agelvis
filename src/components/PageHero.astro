---
/**
 * Encabezado de las páginas internas, en el estilo del inicio:
 * fondo oscuro, título condensado a la izquierda y la foto a la derecha fundida con el fondo.
 */
import { Image } from 'astro:assets';

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  breadcrumbs?: { label: string; href?: string }[];
  lang?: 'es' | 'en';
}
const { title, eyebrow, lead, image, imageAlt = '', breadcrumbs = [], lang = 'es' } = Astro.props;
const crumbs = [lang === 'es' ? { label: 'Inicio', href: '/' } : { label: 'Home', href: '/en/' }, ...breadcrumbs];
const crumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: new URL(c.href ?? Astro.url.pathname, Astro.site).toString(),
  })),
};
---
<section class:list={['page-hero', { 'has-image': image }]}>
  {image && (
    <div class="ph-media">
      <Image src={image} alt={imageAlt} widths={[640, 1024, 1600]} sizes="(max-width: 900px) 100vw, 60vw" loading="eager" fetchpriority="high" />
    </div>
  )}
  <div class="ph-grid" aria-hidden="true"></div>
  <div class="container ph-inner">
    {breadcrumbs.length > 0 && (
      <nav aria-label={lang === 'es' ? 'Ruta de navegación' : 'Breadcrumb'} class="crumbs">
        <ol>
          {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
{breadcrumbs.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(crumbsLd)} />}

<style>
  .page-hero { position: relative; isolation: isolate; overflow: hidden; background: var(--surface); min-height: min(78svh, 720px); display: grid; align-items: end; }
  .page-hero:not(.has-image) { min-height: 0; }
  .page-hero:not(.has-image) .ph-inner { padding-bottom: clamp(24px, 4vw, 48px); }
  .ph-media { position: absolute; top: 0; right: 0; bottom: 0; width: 62%; z-index: -2; -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 45%); mask-image: linear-gradient(90deg, transparent 0%, #000 45%); }
  .ph-media img { width: 100%; height: 100%; object-fit: cover; animation: kenburns 22s ease-out both; }
  .has-image::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, var(--surface) 0%, transparent 30%), linear-gradient(90deg, rgb(8 7 26 / 0.6) 30%, transparent 70%); pointer-events: none; }
  .ph-grid { position: absolute; inset: 0; z-index: -3; background-image: linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px); background-size: 64px 64px; mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent); }
  .ph-inner { position: relative; padding-block: 150px clamp(56px, 8vw, 96px); animation: rise 0.9s var(--ease) both; }
  h1 { color: #fff; max-width: 16ch; font-size: clamp(2.6rem, 5.6vw, 5rem); line-height: 0.92; margin-bottom: 20px; }
  .lead { color: #cfcde4; font-size: clamp(1.05rem, 1.4vw, 1.2rem); max-width: 50ch; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0 0 22px; padding: 0; font-size: 0.88rem; }
  .crumbs li:not(:last-child)::after { content: '/'; margin-left: 6px; color: #5d5a80; }
  .crumbs a { color: var(--ink-soft); text-decoration: none; }
  .crumbs a:hover { color: var(--brand-amber); }
  .crumbs span { color: #fff; }
  @keyframes kenburns { from { scale: 1.1; } to { scale: 1; } }
  @keyframes rise { from { opacity: 0; translate: 0 24px; } to { opacity: 1; translate: 0 0; } }
  @media (max-width: 900px) {
    .page-hero { min-height: 0; }
    .ph-media { width: 100%; bottom: auto; height: 62%; -webkit-mask-image: linear-gradient(0deg, transparent 0%, #000 60%); mask-image: linear-gradient(0deg, transparent 0%, #000 60%); }
    .has-image::after { background: linear-gradient(0deg, var(--surface) 30%, rgb(8 7 26 / 0.6) 62%, rgb(8 7 26 / 0.45) 100%); }
    .ph-inner { padding-top: 46vw; }
  }
</style>
