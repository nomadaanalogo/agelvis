---
import Icon from './Icon.astro';
import { whatsappUrl } from '../data/site';

interface Props { title?: string; text?: string; lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const es = lang === 'es';
const {
  title = es ? '¿Tiene un proyecto de montaje, traslado o relocalización?' : 'Planning an installation, transfer or plant relocation?',
  text = es
    ? 'Cuéntenos qué maquinaria necesita intervenir y dónde. Le respondemos con los siguientes pasos para una evaluación técnica.'
    : 'Tell us what machinery needs to move and where. We reply with the next steps for a technical assessment.',
} = Astro.props;
const waMsg = es ? undefined : 'Hello AGELVIS EU, I would like a technical assessment for an industrial machinery project.';
---
<section class="cta-wrap">
  <div class="container">
    <div class="cta-band" data-reveal>
      <svg class="deco" viewBox="0 0 200 200" aria-hidden="true"><circle cx="100" cy="100" r="80" /><circle cx="100" cy="100" r="55" /><circle cx="100" cy="100" r="30" /></svg>
      <div class="text">
        <span class="icon-tile icon-tile--orange"><Icon name="clipboard" /></span>
        <div>
          <h2>{title}</h2>
          <p>{text}</p>
        </div>
      </div>
      <div class="btn-row">
        <a href={es ? '/contacto' : '/en/#contact'} class="btn btn--primary" data-track="cta_click" data-track-location="banda-cta">{es ? 'Solicitar evaluación técnica' : 'Request a technical assessment'} <Icon name="arrow" /></a>
        <a href={whatsappUrl(waMsg)} target="_blank" rel="noopener" class="btn btn--ghost" data-track="whatsapp_click" data-track-location="banda-cta"><Icon name="whatsapp" /> WhatsApp</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-wrap { padding-block: clamp(48px, 7vw, 88px); }
  .cta-band {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1.5fr auto;
    gap: 32px;
    align-items: center;
    padding: clamp(32px, 5vw, 56px);
    border-radius: var(--radius-lg);
    color: #fff;
    background:
      radial-gradient(60% 120% at 100% 0%, rgb(251 122 48 / 0.35), transparent 60%),
      var(--grad-blue);
    box-shadow: 0 30px 60px -30px rgb(24 0 173 / 0.6);
  }
  .deco { position: absolute; right: -60px; bottom: -80px; width: 320px; z-index: -1; fill: none; stroke: rgb(255 255 255 / 0.12); stroke-width: 1.5; animation: spin 40s linear infinite; }
  .text { display: flex; gap: 20px; align-items: flex-start; }
  h2 { color: #fff; font-size: clamp(1.6rem, 2.8vw, 2.2rem); max-width: 24ch; }
  p { margin: 0; color: #dcdaf5; max-width: 60ch; }
  @keyframes spin { to { rotate: 360deg; } }
  @media (max-width: 860px) { .cta-band { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .text { flex-direction: column; } }
</style>
